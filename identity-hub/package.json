{
  "name": "postern-identity-hub",
  "version": "0.1.0",
  "private": true,
  "description": "Privacy-first hub for email aliases, real inboxes, and VoIP numbers. Paid with crypto.",
  "type": "module",
  "engines": { "node": ">=22.13" },
  "scripts": {
    "start": "node server/index.js",
    "dev": "node --watch server/index.js",
    "test": "node --no-warnings=ExperimentalWarning --test --test-concurrency=1 \"test/*.test.js\"",
    "test:e2e": "node e2e/run.mjs"
  },
  "dependencies": {
    "@simplewebauthn/server": "14.1.0",
    "mailparser": "3.14.3",
    "nodemailer": "10.5.0",
    "smtp-server": "3.21.4"
  }
}
