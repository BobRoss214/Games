# Postern settings.
#
# 1. Copy this file:   cp .env.example .env
# 2. Change the values in the .env file. Do not change this example file.
# 3. Apply a change:   docker compose up -d
#
# Rules for this file:
# - One setting on each line: NAME=value. No spaces around "=".
# - Do not write a comment on the same line as a value.
# - If a value contains "$" or "#", put the value in single quotes: NAME='va$lue'
# - An empty value means "use the default".
# - On/off settings accept: true, false.
# - The .env file contains secrets. Keep it private:   chmod 600 .env
#
# docs/SETUP-GUIDE.md tells you where each value comes from.


# ---------------------------------------------------------------------------
# 1. The basics (you must set these)
# ---------------------------------------------------------------------------

# The address of the web app. It must start with https:// . No "/" at the end.
# Passkeys are tied to this host name. Do not change it after users sign up.
PUBLIC_URL=https://mail.example.com

# The name that the web app shows.
APP_NAME=Postern

# The server secret: 64 characters, made with:   openssl rand -hex 32
# Keep a copy offline. Without it, a backup cannot find addresses and numbers.
# If this is empty, Postern makes the file secret.key in the data volume.
SECRET_KEY=

# open = everyone can make an account. closed = no new accounts.
SIGNUP=open


# ---------------------------------------------------------------------------
# 2. Mail
# ---------------------------------------------------------------------------

# The domains for user addresses (name@example.com). Use commas between domains.
MAIL_DOMAINS=example.com

# The name of this mail server. Use the same name in the MX record and in
# the reverse DNS (PTR) record of the server.
MAIL_HOSTNAME=mail.example.com

# Where Postern sends outgoing mail.
# Empty = outgoing mail is NOT sent (test mode).
# Built-in relay (also set COMPOSE_PROFILES=relay in section 9):
#   smtp://relay:587/?tls.rejectUnauthorized=false
# Relay of a mail company (do not add the "?tls..." part here):
#   smtps://USER:PASSWORD@smtp.relay-company.example:465
SMTP_RELAY_URL=

# DKIM signature made by Postern itself. Leave both empty if you use the
# built-in relay: the built-in relay signs the mail.
# Example: DKIM_SELECTOR=postern and DKIM_KEY_FILE=/keys/dkim.key
DKIM_SELECTOR=
DKIM_KEY_FILE=

# Optional certificate for encrypted incoming mail (STARTTLS).
# Example: SMTP_TLS_KEY=/keys/smtp.key and SMTP_TLS_CERT=/keys/smtp.crt
SMTP_TLS_KEY=
SMTP_TLS_CERT=

# Largest message in bytes. 15728640 = 15 MB.
MAIL_MAX_BYTES=15728640


# ---------------------------------------------------------------------------
# 3. Phone numbers
# ---------------------------------------------------------------------------

# off = no phone numbers (email and payments only). twilio = use Twilio.
# Do not use "mock" on a real server. It is a simulation for development.
PHONE_PROVIDER=off

# Countries in which users can get a number. Two-letter codes with commas.
# GB (United Kingdom) needs identity documents at Twilio. See the setup guide.
PHONE_COUNTRIES=US,CA
# Users can text and call only numbers that start with one of these prefixes.
PHONE_ALLOWED_PREFIXES=+1
# ...and never numbers that start with one of these. Empty = the built-in list
# (premium numbers +1900, +1976 and the high-cost Caribbean area codes).
PHONE_BLOCKED_PREFIXES=

# From the Twilio Console. The Auth Token is a secret.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# Optional. The Messaging Service of your approved 10DLC campaign (starts with MG).
# Necessary to SEND texts from US numbers. Postern adds each new number to it.
TWILIO_MESSAGING_SERVICE_SID=
# Optional. Regulatory bundle (starts with BU) and address (starts with AD).
# Some countries need them to buy a number.
TWILIO_BUNDLE_SID=
TWILIO_ADDRESS_SID=
# Do not change. Used only for tests.
TWILIO_BASE_URL=https://api.twilio.com


# ---------------------------------------------------------------------------
# 4. Payments
# ---------------------------------------------------------------------------

# off = no payments. btcpay = use your BTCPay Server.
# Do not use "mock" on a real server. It is a simulation for development.
# If payments are off, set the four prices in section 5 to 0.
PAY_PROVIDER=off

# The address of your BTCPay Server. Example: https://btcpay.example.com
BTCPAY_URL=

# From BTCPay Server. The API key and the webhook secret are secrets.
BTCPAY_STORE_ID=
BTCPAY_API_KEY=
BTCPAY_WEBHOOK_SECRET=

# The payment methods that users can select. Use only methods that your
# BTCPay store has. BTC-LN = Lightning, XMR-CHAIN = Monero, BTC-CHAIN = Bitcoin.
BTCPAY_METHODS=BTC-LN,XMR-CHAIN,BTC-CHAIN

# Smallest and largest payment in US dollars.
PAY_MIN_USD=5
PAY_MAX_USD=200

# A payment request is valid for this number of minutes.
PAY_INVOICE_MINUTES=60


# ---------------------------------------------------------------------------
# 5. Prices (in credits; 100 credits = 1.00 US dollar; 0 = free)
# ---------------------------------------------------------------------------

# One mailbox for 30 days.
PRICE_MAILBOX_MONTH=100

# One phone number for 30 days.
PRICE_NUMBER_MONTH=400

# One sent text.
PRICE_TEXT_OUT=3

# One minute of a call.
PRICE_CALL_MINUTE=3


# ---------------------------------------------------------------------------
# 6. Limits for each account
# ---------------------------------------------------------------------------

# Largest number of mailboxes.
LIMIT_MAILBOXES=25

# Largest number of aliases. 0 = no limit.
LIMIT_ALIASES=0

# Largest number of phone numbers.
LIMIT_NUMBERS=25

# Largest number of real phones for call forwarding.
LIMIT_PHONES=5

# Largest number of sent emails each day. 0 = no limit.
LIMIT_SEND_PER_DAY=100

# Largest size of one mailbox in bytes. 1073741824 = 1 GB.
LIMIT_MAILBOX_BYTES=1073741824

# Largest number of requests each minute from one IP address.
LIMIT_REQUESTS_PER_MINUTE=900


# ---------------------------------------------------------------------------
# 7. Security and accounts (the defaults are good; change them only for a reason)
# ---------------------------------------------------------------------------

# Work that a browser must do before a sign-up. A higher number slows down robots.
POW_BITS=16

# A login stays valid for this number of days.
SESSION_DAYS=30

# Days between "not paid" and "phone number released".
GRACE_DAYS=7

# Rate limits. Keep this on.
RATE_LIMITS=true

# How much the program writes to its log: silent, error, warn, info, debug.
# The log never contains addresses, numbers, message text or IP addresses.
LOG_LEVEL=warn


# ---------------------------------------------------------------------------
# 8. Fixed by docker-compose.yml (do not set these when you use Docker)
# ---------------------------------------------------------------------------
# docker-compose.yml sets these values. A value here has no effect.
# The list is here so that you can see every setting of the program.

# NODE_ENV=production
# HOST=0.0.0.0
# PORT=8080
# SMTP_HOST=0.0.0.0
# SMTP_PORT=2525
# DATA_DIR=/data
# TRUST_PROXY=true


# ---------------------------------------------------------------------------
# 9. Docker only (the Postern program does not read these)
# ---------------------------------------------------------------------------

# Set this to "relay" to start the built-in relay for outgoing mail.
COMPOSE_PROFILES=

# Only if you have more than one mail domain: the same domains as in
# MAIL_DOMAINS, with spaces between them, in double quotes.
# Example: RELAY_DOMAINS="example.com example.org"
RELAY_DOMAINS=

# The log of the built-in relay. none = no log (the log shows who writes to
# whom). local = log on, to find a delivery problem. Set it back to none after.
RELAY_LOG_DRIVER=none
