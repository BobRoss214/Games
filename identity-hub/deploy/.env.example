# Postern settings.
#
# 1. Copy this file:   cp .env.example .env
# 2. Change the values in the .env file. Do not change this example file.
# 3. Apply a change:   docker compose up -d
#
# Rules for this file:
# - One setting on each line: NAME=value. No spaces around "=".
# - Do not write a comment on the same line as a value.
# - If a value contains "$" or "#", put the value in single quotes: NAME='va$lue'
# - An empty value means "use the default".
# - On/off settings accept: true, false.
# - The .env file contains secrets. Keep it private:   chmod 600 .env
#
# docs/SETUP-GUIDE.md tells you where each value comes from.


# ---------------------------------------------------------------------------
# 1. The basics (you must set these)
# ---------------------------------------------------------------------------

# The address of the web app. It must start with https:// . No "/" at the end.
# Passkeys are tied to this host name. Do not change it after users sign up.
PUBLIC_URL=https://mail.example.com

# The name that the web app shows.
APP_NAME=Postern

# The server secret: 64 characters, made with:   openssl rand -hex 32
# Keep a copy offline. Without it, a backup cannot find addresses and numbers.
# If this is empty, Postern makes the file secret.key in the data volume.
SECRET_KEY=

# open = everyone can make an account. closed = no new accounts.
SIGNUP=open


# ---------------------------------------------------------------------------
# 2. Mail
# ---------------------------------------------------------------------------

# The domains for user addresses (name@example.com). Use commas between domains.
# Postern uses the first domain when a user does not select a domain.
# All users of the server can use all domains in this list.
# To add a domain of your own later, see Part H of the setup guide.
MAIL_DOMAINS=example.com
# Optional. Domains from MAIL_DOMAINS that only you use. The app then warns:
# aliases on a personal domain can be linked to each other.
MAIL_PERSONAL_DOMAINS=

# The name of this mail server. Use the same name in the MX record and in
# the reverse DNS (PTR) record of the server.
MAIL_HOSTNAME=mail.example.com

# Where Postern sends outgoing mail.
# Empty = Postern refuses mail to other servers. Mail between addresses of
# this server still works.
# Built-in relay (also set COMPOSE_PROFILES=relay in section 9):
#   smtp://relay:587/?tls.rejectUnauthorized=false
# Relay of a mail company (do not add the "?tls..." part here):
#   smtps://USER:PASSWORD@smtp.relay-company.example:465
SMTP_RELAY_URL=

# DKIM signature made by Postern itself. Leave both empty if you use the
# built-in relay: the built-in relay signs the mail.
# Example: DKIM_SELECTOR=postern and DKIM_KEY_FILE=/keys/dkim.key
DKIM_SELECTOR=
DKIM_KEY_FILE=

# Certificate for encrypted incoming mail (STARTTLS).
# Empty = Postern makes its own certificate at the first start. This is
# sufficient for mail. To use the certificate of your web address, see
# Part D3 of the setup guide. Set the two values together.
# Example: SMTP_TLS_KEY=/keys/smtp.key and SMTP_TLS_CERT=/keys/smtp.crt
# Postern reads changed files in 10 minutes or less, without a restart.
SMTP_TLS_KEY=
SMTP_TLS_CERT=

# Largest message in bytes. 15728640 = 15 MB.
MAIL_MAX_BYTES=15728640


# ---------------------------------------------------------------------------
# 3. Phone numbers
# ---------------------------------------------------------------------------

# off = no phone numbers (email and payments only). twilio = use Twilio.
# ownphone = your own Android phone with a SIM card: texts only, no calls.
# See Part I of the setup guide before you use it.
# Do not use "mock" on a real server. It is a simulation for development.
PHONE_PROVIDER=off

# Countries in which users can get a number. Two-letter codes with commas.
# Some countries need identity documents at Twilio (example: GB, the United
# Kingdom). Add such a country only after you set TWILIO_BUNDLE_SID and
# TWILIO_ADDRESS_SID below. See Part F5 of the setup guide.
PHONE_COUNTRIES=US,CA

# Users can text and call only numbers that start with one of these prefixes.
# The same limit applies to a real phone that a user links.
# +1 = United States and Canada. Example for one more country: +1,+44
# "+" alone permits all countries. Empty = the default (+1).
PHONE_ALLOWED_PREFIXES=+1

# Users can never text or call numbers that start with one of these prefixes.
# Empty = the built-in list: the premium numbers +1900 and +1976, and 21
# expensive area codes inside +1 (most of them in the Caribbean).
# A value here replaces the built-in list. Part F6 of the setup guide has
# the complete built-in list.
PHONE_BLOCKED_PREFIXES=

# The longest voicemail in seconds.
VOICEMAIL_MAX_SECONDS=120

# From the Twilio Console. The Auth Token is a secret.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# Optional. The Messaging Service of your approved 10DLC campaign (starts with MG).
# Necessary to SEND texts from US numbers. Postern adds each new number to it.
TWILIO_MESSAGING_SERVICE_SID=
# Optional. Regulatory bundle (starts with BU) and address (starts with AD)
# from the Twilio Console. Some countries need them to buy a number.
# Postern sends the two IDs with each purchase.
# This function was tested with a simulated Twilio only.
TWILIO_BUNDLE_SID=
TWILIO_ADDRESS_SID=
# Do not change. Used only for tests.
TWILIO_BASE_URL=https://api.twilio.com

# --- Your own phone (PHONE_PROVIDER=ownphone). See Part I of the setup guide. ---
# The address of the gateway as Postern reaches it. Empty = the gateway of this
# Docker project: http://smsgate:3000/api/3rdparty/v1
OWNPHONE_API_URL=
# How often a phone reports that it is alive, in seconds. A phone gets this
# value when you add it with the tool. A shorter time uses more battery.
OWNPHONE_PING_SECONDS=300
# A phone with no report for this number of minutes shows as "offline".
# Use 3 times OWNPHONE_PING_SECONDS, or more.
OWNPHONE_OFFLINE_MINUTES=15
# A text that the phone did not send in this number of seconds fails.
# The user gets the credit for it back.
OWNPHONE_TEXT_TTL_SECONDS=3600


# ---------------------------------------------------------------------------
# 4. Payments
# ---------------------------------------------------------------------------

# off = no payments. btcpay = use your BTCPay Server.
# Do not use "mock" on a real server. It is a simulation for development.
# If payments are off, set the five prices in section 5 to 0.
PAY_PROVIDER=off

# The address of your BTCPay Server. Example: https://btcpay.example.com
BTCPAY_URL=

# From BTCPay Server. The API key and the webhook secret are secrets.
BTCPAY_STORE_ID=
BTCPAY_API_KEY=
BTCPAY_WEBHOOK_SECRET=

# The payment methods that users can select. Use only methods that your
# BTCPay store has. BTC-LN = Lightning, XMR-CHAIN = Monero, BTC-CHAIN = Bitcoin.
BTCPAY_METHODS=BTC-LN,XMR-CHAIN,BTC-CHAIN

# Smallest and largest payment in US dollars.
PAY_MIN_USD=5
PAY_MAX_USD=200

# A payment request is valid for this number of minutes.
PAY_INVOICE_MINUTES=60


# ---------------------------------------------------------------------------
# 5. Prices (in credits; 100 credits = 1.00 US dollar; 0 = free)
# ---------------------------------------------------------------------------

# One inbox for 30 days.
PRICE_MAILBOX_MONTH=100

# One phone number for 30 days.
PRICE_NUMBER_MONTH=400

# One sent text.
PRICE_TEXT_OUT=3

# One minute of a call. A call that says the code for a real phone costs
# this price one time.
PRICE_CALL_MINUTE=3

# One recorded voicemail.
PRICE_VOICEMAIL=5


# ---------------------------------------------------------------------------
# 6. Limits for each account
# ---------------------------------------------------------------------------

# Largest number of inboxes. 0 = no limit.
LIMIT_MAILBOXES=25

# Largest number of aliases. 0 = no limit.
LIMIT_ALIASES=0

# Largest number of phone numbers.
LIMIT_NUMBERS=25

# Largest number of real phones for call forwarding.
LIMIT_PHONES=5

# Largest number of sent emails each day. 0 = no limit.
LIMIT_SEND_PER_DAY=100

# Largest number of blocked senders for one address.
LIMIT_ADDRESS_BLOCKS=200

# Largest size of one inbox in bytes. 1073741824 = 1 GB. 0 = no limit.
LIMIT_MAILBOX_BYTES=1073741824

# Largest number of requests each minute from one IP address.
LIMIT_REQUESTS_PER_MINUTE=900


# ---------------------------------------------------------------------------
# 7. Security and accounts (the defaults are good; change them only for a reason)
# ---------------------------------------------------------------------------

# Work that a browser must do before a sign-up. A higher number slows down robots.
POW_BITS=16

# A login stays valid for this number of days.
SESSION_DAYS=30

# A number that is not paid is paused. After this number of days, Postern
# releases the paused number at the phone provider. A paused inbox is kept.
GRACE_DAYS=7

# Rate limits. Keep this on.
RATE_LIMITS=true

# How much the program writes to its log: silent, error, warn, info, debug.
# The log never contains addresses, numbers, message text or IP addresses.
LOG_LEVEL=warn


# ---------------------------------------------------------------------------
# 8. Fixed by docker-compose.yml (do not set these when you use Docker)
# ---------------------------------------------------------------------------
# docker-compose.yml sets these values. A value here has no effect.
# The list is here so that you can see every setting of the program.

# NODE_ENV=production
# HOST=0.0.0.0
# PORT=8080
# SMTP_HOST=0.0.0.0
# SMTP_PORT=2525
# DATA_DIR=/data
# TRUST_PROXY=true


# ---------------------------------------------------------------------------
# 9. Docker only (the Postern program does not read these)
# ---------------------------------------------------------------------------

# The optional parts that Docker starts. Names with commas, no spaces.
# relay = the built-in relay for outgoing mail (Part D1).
# ownphone = the gateway for your own phone (Part I).
# Example for the two together: COMPOSE_PROFILES=relay,ownphone
COMPOSE_PROFILES=

# Mandatory if MAIL_DOMAINS has more than one domain and you use the built-in
# relay: the same domains as in MAIL_DOMAINS, with spaces between them, in
# double quotes. Example: RELAY_DOMAINS="example.com my-own-domain.example"
RELAY_DOMAINS=

# The log of the built-in relay. none = no log (the log shows who writes to
# whom). local = log on, to find a delivery problem. Set it back to none after.
RELAY_LOG_DRIVER=none

# --- The gateway for your own phone (profile "ownphone"). See Part I. ---
# The second name of your server, for the gateway. It needs its own DNS record.
# Only the name: no https:// and no "/". Example: sms.example.com
SMSGATE_HOST=
# A phone can connect to your gateway only with this token. Make it with:
#   openssl rand -hex 24
SMSGATE_PRIVATE_TOKEN=
# Two passwords for the database of the gateway. Make each one with:
#   openssl rand -hex 24
# Do not change them after the first start.
SMSGATE_DB_PASSWORD=
SMSGATE_DB_ROOT_PASSWORD=
# How long the gateway keeps its rows of texts. Use a number with "h" (hours).
SMSGATE_KEEP=24h
# The version of the gateway program. Empty = the version in docker-compose.yml.
SMSGATE_VERSION=
# The log of the gateway. local = log on. none = no log.
SMSGATE_LOG_DRIVER=local
